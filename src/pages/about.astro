---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Scorecard from '../components/Scorecard.astro';
import Enquiry from '../components/Enquiry.astro';
import { site, sisterBrands, team } from '../data/site';
import { breadcrumb } from '../lib/schema';
import '../styles/inner.css';

const people = team.map((t) => ({
  '@type': 'Person',
  name: t.name,
  jobTitle: 'Golf videographer',
  worksFor: { '@id': site.url + '/#business' },
  url: site.url + '/about/',
}));
const starkey = sisterBrands[0];
---
<Base
  title="About Keegan Starkey & Sam Fry, Golf Videographers | Bad At Golf"
  description="Bad At Golf is Keegan Starkey and Sam Fry, two golf videographers and golf mates based in Milton Keynes who plan, film and edit every project themselves."
  current="about"
  schema={[...people, breadcrumb([{ name: 'About', path: '/about/' }])]}
>
  <PageHero
    crumbs={[{ name: 'About' }]}
    kicker="About Bad At Golf"
    title="Golf videographers who are bad at golf"
    lede={`Bad At Golf is ${site.team}, two videographers and golf mates based in ${site.town}. The people you message are the ones who turn up, film it and edit it.`}
    cta={{ label: 'Get in touch', href: '#enquire' }}
    cta2={{ label: 'Watch the work', href: '/work/' }}
  >
    <Scorecard slot="media" class="ab-sc" />
  </PageHero>

  <section class="sec gut paper" aria-labelledby="why-h">
    <div class="wrap">
      <h2 class="sr-only" id="why-h">Why Bad At Golf exists</h2>
      <figure class="ab-quote">
        <blockquote><p>“Between the two of us we've lost more golf balls than we'd like to admit. So we stopped trying to fix our own swings and started filming everyone else's. Turns out we're much better behind a camera than over a four-foot putt.”</p></blockquote>
        <figcaption>Keegan and Sam</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec gut paper" aria-labelledby="team-h" style="padding-top:0">
    <div class="wrap">
      <h2 class="h2" id="team-h" style="margin-bottom:clamp(28px,3.5vw,48px)">The two of us</h2>
      <ul class="team">
        {team.map((t) => (
          <li>
            {t.photo
              ? <img src={t.photo} alt={t.photoAlt || t.name} loading="lazy" width="1400" height="1749" />
              : <span class="team-ph" aria-hidden="true"><span class="flag-mark"></span></span>}
            <div>
              <h3 class="h3">{t.name}</h3>
              <p class="team-role">{t.role}</p>
              <p>{t.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec gut paper" aria-labelledby="ab-h" style="padding-top:0">
    <div class="wrap intro2">
      <h2 class="h2" id="ab-h">Golf mates first, crew second</h2>
      <div class="prose">
        <p>Bad At Golf started the way most good ideas do, somewhere between the ninth green and the bar. Two videographers who play together, film together and know the game well enough to know what's worth pointing a camera at.</p>
        <p>It sits alongside <a href={starkey.url} target="_blank" rel="noopener">Starkey Productions</a>, Keegan's video company for businesses and events, with the same cameras and the same care, just pointed at golf. Every project is planned, filmed and edited by the two of us, so you get two people who care about it and one look across everything you post.</p>
      </div>
    </div>
  </section>

  <section class="sec gut paper" aria-labelledby="how-h" style="padding-top:0">
    <div class="wrap">
      <h2 class="h2" id="how-h" style="margin-bottom:clamp(28px,3.5vw,48px)">How the work gets made</h2>
      <ul class="kit">
        <li><h3 class="h3">Two of us, start to finish</h3><p>No account managers or hand-offs. The people who plan the shoot are the ones filming it and cutting it.</p></li>
        <li><h3 class="h3">Two cameras, light kit</h3><p>Two shooters means two angles on every swing and every moment, with a small setup that doesn't hold up play.</p></li>
        <li><h3 class="h3">Cut for where it's watched</h3><p>Landscape for your website and YouTube, vertical for Instagram and TikTok, all from the same shoot.</p></li>
      </ul>
    </div>
  </section>

  <Enquiry heading="Tee it up" preset="unsure" page="About" />
</Base>
