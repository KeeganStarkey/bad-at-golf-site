---
import Base from '../layouts/Base.astro';
import { whatsappLink } from '../data/site';
import '../styles/inner.css';
---
<Base title="Thanks | Bad At Golf" description="Your enquiry has been sent." noindex enquireHref="/contact/" mbar="">
  <section class="phead pine gut" data-hero aria-labelledby="ty-h" style="min-height:70svh">
    <div class="wrap">
      <h1 class="h1" id="ty-h">In the hole.</h1>
      <p class="lede">Thanks for getting in touch. Your enquiry is with Keegan, and you'll hear back within one working day. If it's urgent, <a href={whatsappLink()}>send a WhatsApp</a>.</p>
      <div class="ctas"><a class="btn" href="/work/">Watch some work</a><a class="btn-line" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
