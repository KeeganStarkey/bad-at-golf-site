---
import Base from '../layouts/Base.astro';
import Clip from '../components/Clip.astro';
import Enquiry from '../components/Enquiry.astro';
import { films } from '../data/videos';
import { breadcrumb, videoObjects } from '../lib/schema';
import '../styles/inner.css';

const catLabel: Record<string, string> = { clubs: 'Golf clubs', coaches: 'Coaches', players: 'Players and brands', documentary: 'Documentary' };
const cats = Object.keys(catLabel).filter((c) => films.some((f) => f.cat === c));
---
<Base
  title="Golf Video Work for Courses, Coaches & Brands | Bad At Golf"
  description="Golf videos by Bad At Golf. Golf course films, coaching content, player reels, brand films and documentaries, filmed in the UK and abroad."
  current="work"
  schema={[breadcrumb([{ name: 'Work', path: '/work/' }]), ...videoObjects(films.map((f) => f.key))]}
>
  <section class="phead pine gut" data-hero aria-labelledby="work-h">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><span aria-current="page">Work</span></li></ol></nav>
      <h1 class="h1" id="work-h">Golf video work</h1>
      <p class="lede">Golf course films, coaching content, player reels and documentaries. Press play on any of them to watch with sound.</p>
    </div>
  </section>

  <section class="sec gut paper" aria-label="Films">
    <div class="wrap">
      <div class="sec-head">
        <p class="muted">{films.length} {films.length === 1 ? 'film' : 'films'}</p>
        {cats.length > 1 && (
          <div class="filters" role="group" aria-label="Filter work" data-filter-for="wk-grid">
            <button type="button" data-f="all" aria-pressed="true">All</button>
            {cats.map((c) => <button type="button" data-f={c} aria-pressed="false">{catLabel[c]}</button>)}
          </div>
        )}
      </div>
      <div class="wk-grid" id="wk-grid">
        {films.map((f) => <Clip k={f.key} cat={f.cat} />)}
      </div>
    </div>
  </section>

  <Enquiry heading="Want one of these?" preset="unsure" page="Work" />
</Base>

<script>
  import '../scripts/filter';
</script>
