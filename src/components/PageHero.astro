---
// Inner page hero on pine: breadcrumbs, the page's one H1, a lede and footage or a photo.
import Clip from './Clip.astro';
import { videos } from '../data/videos';

interface Props {
  crumbs?: { name: string; href?: string }[];
  title: string;
  kicker?: string;
  lede: string;
  k?: string;
  photo?: string;
  photoAlt?: string;
  cta?: { label: string; href: string };
  cta2?: { label: string; href: string };
}
const { crumbs = [], title, kicker, lede, k, photo, photoAlt = '', cta, cta2 } = Astro.props;
const tall = (k && videos[k]?.ratio === '9:16') || !!photo;
---
<section class="phero pine gut" data-hero aria-labelledby="ph-h">
  <div class:list={['wrap', 'phero-in', { tall }]}>
    <div>
      {crumbs.length > 0 && (
        <nav class="crumb" aria-label="Breadcrumb"><ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c) => (<><li aria-hidden="true">/</li><li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li></>))}
        </ol></nav>
      )}
      <h1 class="h1" id="ph-h">{kicker && <span class="kicker">{kicker}</span>}<Fragment set:html={title} /></h1>
      <p class="lede">{lede}</p>
      {(cta || cta2) && (
        <div class="ctas">
          {cta && <a class="btn" href={cta.href}>{cta.label}</a>}
          {cta2 && <a class="btn-line" href={cta2.href}>{cta2.label}</a>}
        </div>
      )}
    </div>
    <div class="phero-media">
      {photo ? <img class="phero-photo" src={photo} alt={photoAlt} width="1400" height="1749" fetchpriority="high" /> : k ? <Clip k={k} caption={false} /> : null}
    </div>
  </div>
</section>
